{
  automergeStrategy: 'squash',
  automergeType: 'pr-comment',
  automergeComment: '/merge',
  platformAutomerge: false,
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':semanticCommits',
  ],
  dependencyDashboard: false,
  labels: [
    'dependencies',
  ],
  timezone: 'Asia/Tokyo',
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  postUpdateOptions: [
    'gomodTidy',
  ],
  mise: {
    enabled: true,
  },
  packageRules: [
    {
      description: 'Automerge csm-ci-actions reusable workflow pin bumps',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      matchPackageNames: [
        '/^civitaspo/csm-ci-actions/',
      ],
    },
    {
      description: 'Automerge non-major updates (minor, patch, pin, digest)',
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'pinDigest',
        'digest',
      ],
      automerge: true,
    },
    {
      description: 'Do not automerge major updates',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      labels: [
        'dependencies',
        'major',
      ],
    },
  ],
}
